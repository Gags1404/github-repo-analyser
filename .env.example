# GitHub Repository Analyzer - Environment Variables
# Copy this file to .env and update the values as needed

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production  # Use 'development' for local development

# Database Configuration
DATABASE_URL=sqlite:////data/github_repos.db  # Docker path for persistent storage

# Security
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secure_random_key_here

# GitHub API
# Create a token at: https://github.com/settings/tokens
# Recommended scopes: public_repo, read:user, read:org
GITHUB_TOKEN=your_github_personal_access_token

# Cache Settings
CACHE_TIMEOUT=3600  # Cache timeout in seconds (default: 1 hour)

# Docker Specific Settings
# Number of Gunicorn workers (2-4 x CPU cores is recommended)
WEB_CONCURRENCY=4

# Gunicorn worker timeout in seconds
WORKER_TIMEOUT=60

# Log level (debug, info, warning, error, critical)
LOG_LEVEL=info

# Enable/disable debug mode (true/false)
DEBUG=false
